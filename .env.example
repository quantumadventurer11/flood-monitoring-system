POSTGRES_DB=flooddb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Local Docker Compose database URL
DATABASE_URL=postgresql://postgres:postgres@db:5432/flooddb

# Production database URL format, supplied by Render Postgres:
# DATABASE_URL=postgresql://user:password@host:5432/database

COPERNICUS_USER=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-project.vercel.app
VITE_API_URL=http://localhost:8000
